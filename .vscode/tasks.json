{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start AudioTag server",
      "type": "shell",
      "command": "python",
      "args": ["-m", "http.server", "8000"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "name": "AudioTag Server"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Start AudioTag server (py launcher)",
      "type": "shell",
      "command": "py",
      "args": ["-m", "http.server", "8000"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "name": "AudioTag Server"
      },
      "problemMatcher": []
    }
  ]
}
